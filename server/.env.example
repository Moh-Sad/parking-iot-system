# --- Server ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- Database (matches docker-compose) ---
DATABASE_URL=postgresql://parking:parking@localhost:5432/parking_iot?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-please-rotate
JWT_REFRESH_SECRET=change-me-refresh-secret-please-rotate
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Mail (MailHog by default; UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Parking IoT <no-reply@parking-iot.local>"

# --- Bootstrap (used by seed) ---
SEED_ADMIN_EMAIL=admin@parking-iot.local
SEED_ADMIN_PASSWORD=Admin123!
